{% comment %}
  Lists projects from _data/projects.yml (newest first), using the same markup
  as the publication list so it inherits the theme's look.
  Parameters:
    limit=3         only the latest N projects (home page)
    plain=true      no year badge; the year closes the funder line
    by_year=true    year headings like the publications page (entries are plain)
{% endcomment %}
{%- assign project_limit = include.limit | default: 1000 -%}
{%- assign project_plain = include.plain -%}
<div class="publications">
  {%- if include.by_year %}
    {%- assign project_years = site.data.projects | group_by: 'year' %}
    {%- for year_group in project_years %}
      <h2 class="bibliography">{{ year_group.name }}</h2>
      <ol class="bibliography">
        {%- for project in year_group.items %}
          {% include project_item.liquid project=project plain=true %}
        {%- endfor %}
      </ol>
    {%- endfor %}
  {%- else %}
    <ol class="bibliography">
      {%- for project in site.data.projects limit: project_limit %}
        {% include project_item.liquid project=project plain=project_plain %}
      {%- endfor %}
    </ol>
  {%- endif %}
</div>
