{% comment %}
  Lists projects from _data/projects.yml (newest first), using the same markup
  as the publication list so it inherits the theme's look.
  Usage: include project_list.liquid (all projects) or with limit=3 (latest three).
{% endcomment %}
{%- assign project_limit = include.limit | default: 1000 -%}
{%- assign title_key = 'title_' | append: site.active_lang -%}
{%- assign funder_key = 'funder_' | append: site.active_lang -%}
{%- assign project_strings = site.data[site.active_lang].strings.projects -%}
<div class="publications">
  <ol class="bibliography">
    {%- for project in site.data.projects limit: project_limit %}
      <li>
        <div class="row">
          <div class="col col-sm-2 abbr">
            <abbr class="badge rounded w-100">{{ project.year }}</abbr>
          </div>
          <div class="col-sm-8">
            <div class="title">{{ project[title_key] | default: project.title_tr }}</div>
            <div class="author">{{ project_strings.roles[project.role] }}</div>
            <div class="periodical">
              <em>{{ project[funder_key] }}</em>
              {%- if project.code %} ({{ project.code }}){% endif %}
            </div>
          </div>
        </div>
      </li>
    {%- endfor %}
  </ol>
</div>
